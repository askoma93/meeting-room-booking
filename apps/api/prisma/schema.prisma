generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMINISTRATOR
}

enum BookingStatus {
  ACTIVE
  CANCELLED
}

model User {
  id                String    @id @default(uuid()) @db.Uuid
  name              String
  email             String    @unique
  role              UserRole  @default(USER)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)
  bookings          Booking[] @relation("BookingOwner")
  cancelledBookings Booking[] @relation("BookingCanceller")
}

model Room {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique
  capacity  Int
  location  String
  equipment String[]  @default([])
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  bookings  Booking[]
}

model Booking {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @db.Uuid
  roomId            String        @db.Uuid
  startAt           DateTime      @db.Timestamptz(3)
  endAt             DateTime      @db.Timestamptz(3)
  status            BookingStatus @default(ACTIVE)
  cancelledAt       DateTime?     @db.Timestamptz(3)
  cancelledByUserId String?       @db.Uuid
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)
  user              User          @relation("BookingOwner", fields: [userId], references: [id])
  room              Room          @relation(fields: [roomId], references: [id])
  cancelledBy       User?         @relation("BookingCanceller", fields: [cancelledByUserId], references: [id], onDelete: Restrict)

  @@index([userId, startAt])
  @@index([roomId, startAt, endAt])
  @@index([roomId, status, startAt])
}
