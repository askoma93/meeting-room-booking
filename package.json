    "jsdom": "^27.1.0",
    "nx": "23.1.0",
    "prettier": "3.9.6",
    "prisma": "^7.9.0",
    "ts-jest": "^29.4.7",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "tsx": "^4.23.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.0.8",
    "webpack": "^5.101.3",
