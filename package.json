{
  "name": "meeting-room-booking",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "nx": "nx",
    "graph": "nx graph",
    "format": "nx format:write",
    "format:check": "nx format:check",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "test:unit": "nx run web:test",
    "test:api": "nx run api:test",
    "e2e": "nx run web-e2e:e2e",
    "build": "nx run-many -t build",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "db:start": "docker compose up -d postgres",
    "db:stop": "docker compose stop postgres",
    "db:test:start": "docker compose --profile test up -d postgres-test",
    "db:test:stop": "docker compose --profile test stop postgres-test",
    "db:generate": "prisma generate --config apps/api/prisma.config.ts",
    "db:validate": "prisma validate --config apps/api/prisma.config.ts",
    "db:migrate": "prisma migrate deploy --config apps/api/prisma.config.ts",
    "db:migrate:dev": "prisma migrate dev --config apps/api/prisma.config.ts",
    "db:seed": "prisma db seed --config apps/api/prisma.config.ts",
    "db:test:migrate": "cross-env NODE_ENV=test prisma migrate deploy --config apps/api/prisma.config.ts",
    "db:test:seed": "cross-env NODE_ENV=test prisma db seed --config apps/api/prisma.config.ts"
  },
  "devDependencies": {
    "@angular-devkit/architect": "~0.2102.0",
    "@angular-devkit/core": "~21.2.0",
